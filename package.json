{
  "name": "houkago-link",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "lint": "eslint src functions",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:dev": "npm run build && npx wrangler pages dev dist --d1=DB=houkago-link-db --ai=AI",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name=houkago-link"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "motion": "^14.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.4",
    "wrangler": "^4.0.0"
  }
}
